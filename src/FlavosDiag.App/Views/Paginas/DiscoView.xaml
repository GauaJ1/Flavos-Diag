<UserControl x:Class="FlavosDiag.App.Views.Paginas.DiscoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FlavosDiag.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="LinhaTemplate" DataType="{x:Type vm:LinhaInfo}">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Rotulo}" Style="{StaticResource RotuloCampo}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding Valor}" Margin="0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ValorCampo}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Ausente}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource FlavosInconclusivo}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DiscoTemplate" DataType="{x:Type vm:DiscoExibicao}">
            <Border Style="{StaticResource Cartao}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Selo}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding VereditoTexto}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding Nome}" Style="{StaticResource TituloSecao}" FontSize="15" />
                            <TextBlock Text="{Binding Tipo}" Style="{StaticResource TextoSuave}" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Detalhes}" ItemTemplate="{StaticResource LinhaTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}"
                        Content="Ler novamente" Command="{Binding AtualizarCommand}" />
                <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="{Binding Status}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding Discos}" ItemTemplate="{StaticResource DiscoTemplate}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
