<UserControl x:Class="FlavosDiag.App.Views.Paginas.SistemaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FlavosDiag.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="LinhaItem" TargetType="ContentControl">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <DataTemplate x:Key="LinhaTemplate" DataType="{x:Type vm:LinhaCampo}">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Rotulo}" Style="{StaticResource RotuloCampo}" />
                <TextBlock Grid.Column="1" Text="{Binding Valor}" Style="{StaticResource ValorCampo}" Margin="0" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Ler novamente" Command="{Binding AtualizarCommand}" />
                <TextBlock Text="{Binding ColetadoEm}" VerticalAlignment="Center" Style="{StaticResource TextoSuave}" />
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Cartao}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Sistema operacional" Style="{StaticResource TituloSecao}" FontSize="15" />
                            <ItemsControl ItemsSource="{Binding CamposSistema}" ItemTemplate="{StaticResource LinhaTemplate}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Cartao}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="BIOS/UEFI e placa-mãe" Style="{StaticResource TituloSecao}" FontSize="15" />
                            <ItemsControl ItemsSource="{Binding CamposBios}" ItemTemplate="{StaticResource LinhaTemplate}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Cartao}">
                        <StackPanel>
                            <TextBlock Text="Processador" Style="{StaticResource TituloSecao}" FontSize="15" />
                            <ItemsControl ItemsSource="{Binding CamposCpu}" ItemTemplate="{StaticResource LinhaTemplate}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Cartao}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Memória" Style="{StaticResource TituloSecao}" FontSize="15" />
                            <ItemsControl ItemsSource="{Binding CamposMemoria}" ItemTemplate="{StaticResource LinhaTemplate}" />
                            <ItemsControl ItemsSource="{Binding Modulos}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource FlavosBorda}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Local.Valor}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Style="{StaticResource TextoSuave}">
                                                    <Run Text="{Binding CapacidadeBytes.Valor, Mode=OneWay, Converter={StaticResource Bytes}}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Tipo.Valor, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding VelocidadeConfiguradaMhz.Valor, Mode=OneWay}" />
                                                    <Run Text=" MHz · " />
                                                    <Run Text="{Binding Fabricante.Valor, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding NumeroPeca.Valor, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Cartao}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Placa de vídeo" Style="{StaticResource TituloSecao}" FontSize="15" />
                            <ItemsControl ItemsSource="{Binding CamposCadaGpu}" ItemTemplate="{StaticResource LinhaTemplate}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Cartao}">
                        <StackPanel>
                            <TextBlock Text="Telas" Style="{StaticResource TituloSecao}" FontSize="15" />
                            <ItemsControl ItemsSource="{Binding CamposCadaTela}" ItemTemplate="{StaticResource LinhaTemplate}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Cartao}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Rede" Style="{StaticResource TituloSecao}" FontSize="15" />
                    <ItemsControl ItemsSource="{Binding CamposRede}" ItemTemplate="{StaticResource LinhaTemplate}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Cartao}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Bateria" Style="{StaticResource TituloSecao}" FontSize="15" />
                    <ItemsControl ItemsSource="{Binding CamposBateria}" ItemTemplate="{StaticResource LinhaTemplate}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Cartao}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Dispositivos com erro no Gerenciador de Dispositivos" Style="{StaticResource TituloSecao}" FontSize="15" />
                    <ItemsControl ItemsSource="{Binding Dispositivos}" Visibility="{Binding Dispositivos.Count, Converter={StaticResource ColecaoVazia}, ConverterParameter=inverter}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource FlavosBorda}" BorderThickness="0,1,0,0" Padding="0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource TextoSuave}">
                                            <Run Text="{Binding CodigoErro, Mode=OneWay, StringFormat=Código {0}}" FontWeight="SemiBold" Foreground="{DynamicResource FlavosAtencao}" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding Descricao, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="Recomendação: atualizar o driver pela página oficial do fabricante do equipamento ou testar outra porta/slot. O Flavos Diag não instala drivers."
                                                   Style="{StaticResource TextoSuave}" FontSize="11" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Nenhum dispositivo com erro reportado." Style="{StaticResource TextoSuave}"
                               Visibility="{Binding Dispositivos.Count, Converter={StaticResource ColecaoVazia}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Cartao}" Margin="0,14,0,0"
                    Visibility="{Binding Limitacoes.Count, Converter={StaticResource ColecaoVazia}, ConverterParameter=inverter}">
                <StackPanel>
                    <TextBlock Text="Limitações desta coleta" Style="{StaticResource TituloSecao}" FontSize="15" />
                    <ItemsControl ItemsSource="{Binding Limitacoes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource TextoSuave}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
