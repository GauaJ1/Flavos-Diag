<UserControl x:Class="FlavosDiag.App.Views.Paginas.CpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FlavosDiag.App.ViewModels"
             xmlns:c="clr-namespace:FlavosDiag.App.Views.Controles">
    <UserControl.Resources>
        <DataTemplate x:Key="LinhaTemplate" DataType="{x:Type vm:LinhaInfo}">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Rotulo}" Style="{StaticResource RotuloCampo}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding Valor}" Margin="0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ValorCampo}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Ausente}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource FlavosInconclusivo}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Benchmark"
                        Command="{Binding BenchmarquarCommand}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Parar"
                        Command="{Binding EstressarCancelCommand}" Margin="8,0,0,0" MinHeight="40"
                        AutomationProperties.Name="Parar o teste de estresse da CPU"
                        ToolTip="Interrompe o teste que estiver rodando" />
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoPrimario}" Content="Teste de estresse"
                        Command="{Binding EstressarCommand}" />
                <TextBlock Text="{Binding TemperaturaAgora}" Style="{StaticResource TextoSuave}" VerticalAlignment="Center" />
            </DockPanel>


            <TextBlock Text="{Binding Status}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,12" />

            <c:FaixaDiagnosticoSensores Texto="{Binding DiagnosticoSensores}"
                                        Comando="{Binding ComandoInstalacaoDriver}"
                                        MostrarComando="{Binding SugereInstalarDriver}"
                                        ReverificarCommand="{Binding ReverificarSensoresCommand}" />
            <TextBlock Text="{Binding TextoEstresse}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,12" />

            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <TextBlock Text="Processador" Style="{StaticResource TituloSecao}" FontSize="15" />
                    <ItemsControl ItemsSource="{Binding Linhas}" ItemTemplate="{StaticResource LinhaTemplate}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>