<UserControl x:Class="FlavosDiag.App.Views.Paginas.CpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Cartao}" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource Icone}" Data="{StaticResource IconeInterrogacao}" Stroke="{DynamicResource FlavosTextoSuave}" Margin="0,0,10,0" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource TextoSuave}" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
