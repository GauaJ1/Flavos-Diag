<UserControl x:Class="FlavosDiag.App.Views.Paginas.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <Border Style="{StaticResource Cartao}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Identificação do técnico" Style="{StaticResource TituloSecao}" FontSize="15" Margin="0,0,0,10" />

                    <TextBlock Text="Nome do técnico" Style="{StaticResource RotuloCampo}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource CaixaTexto}" Text="{Binding NomeTecnico, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" />

                    <TextBlock Text="Empresa / MEI" Style="{StaticResource RotuloCampo}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource CaixaTexto}" Text="{Binding Empresa, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" />

                    <TextBlock Text="CNPJ" Style="{StaticResource RotuloCampo}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource CaixaTexto}" Text="{Binding Cnpj, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" />

                    <TextBlock Text="Contato (telefone ou e-mail)" Style="{StaticResource RotuloCampo}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource CaixaTexto}" Text="{Binding Contato, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Cartao}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Rede" Style="{StaticResource TituloSecao}" FontSize="15" Margin="0,0,0,10" />

                    <TextBlock Text="Alvos de ping (separados por vírgula)" Style="{StaticResource RotuloCampo}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource CaixaTexto}" Text="{Binding AlvosPing, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" />

                    <TextBlock Text="Nome para teste de DNS" Style="{StaticResource RotuloCampo}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource CaixaTexto}" Text="{Binding NomeDnsTeste, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Cartao}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Stress e temperatura" Style="{StaticResource TituloSecao}" FontSize="15" Margin="0,0,0,10" />

                    <TextBlock Text="Temperatura de alerta no gráfico (°C)" Style="{StaticResource RotuloCampo}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource CaixaTexto}" Text="{Binding LimiarAlertaTexto, UpdateSourceTrigger=PropertyChanged}"
                             MaxWidth="160" HorizontalAlignment="Left" Margin="0,0,0,6"
                             AutomationProperties.Name="Limiar de alerta de temperatura" />
                    <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                               Text="O gráfico destaca esta faixa. É só um aviso visual: não encerra o teste." />

                    <TextBlock Text="Parar o stress sozinho ao atingir (°C)" Style="{StaticResource RotuloCampo}" Margin="0,14,0,4" />
                    <TextBox Style="{StaticResource CaixaTexto}" Text="{Binding LimiteParadaTexto, UpdateSourceTrigger=PropertyChanged}"
                             MaxWidth="160" HorizontalAlignment="Left" Margin="0,0,0,6"
                             AutomationProperties.Name="Limite de parada automática de temperatura" />
                    <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                               Text="Entre 60 e 120 °C (padrão 100). O teste para quando a temperatura do processador fica neste valor por 3 leituras seguidas. O botão Parar continua sempre disponível." />

                    <TextBlock Text="Teto de duração do stress (minutos)" Style="{StaticResource RotuloCampo}" Margin="0,14,0,4" />
                    <TextBox Style="{StaticResource CaixaTexto}" Text="{Binding TetoDuracaoTexto, UpdateSourceTrigger=PropertyChanged}"
                             MaxWidth="160" HorizontalAlignment="Left" Margin="0,0,0,6"
                             AutomationProperties.Name="Teto de duração do stress em minutos" />
                    <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                               Text="Entre 1 e 60 minutos (padrão 30). Sem leitura de temperatura da CPU, o teste para em 2 minutos, salvo se você confirmar a continuação." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Cartao}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Diagnóstico de sensores" Style="{StaticResource TituloSecao}" FontSize="15" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                               Text="Gera um arquivo .json e um .txt com o ambiente (administrador, driver PawnIO, versão do Windows e da biblioteca), a CPU e todos os sensores — inclusive os que não devolveram valor. Útil quando a temperatura não aparece. Não contém números de série." />
                    <Button Style="{StaticResource BotaoSecundario}" Content="Exportar diagnóstico de sensores"
                            Command="{Binding ExportarDiagnosticoSensoresCommand}" Margin="0,10,0,0"
                            HorizontalAlignment="Left" MinHeight="40"
                            AutomationProperties.Name="Exportar diagnóstico de sensores" />
                    <TextBlock Text="{Binding StatusDump}" Style="{StaticResource TextoSuave}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Cartao}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Laudo" Style="{StaticResource TituloSecao}" FontSize="15" Margin="0,0,0,10" />

                    <CheckBox Content="Mascarar números de série no laudo (recomendado)"
                              IsChecked="{Binding MascararSeriais}" Margin="0,0,0,10" />

                    <TextBlock Text="Pasta onde os laudos são salvos" Style="{StaticResource RotuloCampo}" Margin="0,0,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Escolher..."
                                Command="{Binding EscolherPastaCommand}" Margin="8,0,0,0" />
                        <TextBox Style="{StaticResource CaixaTexto}" Text="{Binding PastaExportacao}"
                                 IsReadOnly="True" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BotaoPrimario}" Content="Salvar" Command="{Binding SalvarCommand}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource TextoSuave}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>