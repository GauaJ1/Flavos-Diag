<UserControl x:Class="FlavosDiag.App.Views.Paginas.ChecklistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FlavosDiag.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type vm:ItemChecklistExibicao}">
            <Border Style="{StaticResource Cartao}" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Selo}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusTexto}" />
                        </Border>
                        <TextBlock Text="{Binding Item.Titulo}" Style="{StaticResource TituloSecao}" FontSize="14" />
                    </DockPanel>
                    <TextBlock Text="{Binding Item.Instrucao}" Style="{StaticResource TextoSuave}"
                               TextWrapping="Wrap" Margin="0,4,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="OK" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0" MinWidth="70"
                                Command="{Binding MarcarOkCommand}" />
                        <Button Content="Falha" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0" MinWidth="70"
                                Command="{Binding MarcarFalhaCommand}" />
                        <Button Content="Não se aplica" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0"
                                Command="{Binding MarcarNaoSeAplicaCommand}" />
                        <Button Content="Limpar" Style="{StaticResource BotaoSecundario}" MinWidth="70"
                                Command="{Binding LimparCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}"
                        Content="Zerar itens" Command="{Binding ZerarCommand}" />
                <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding Itens}" ItemTemplate="{StaticResource ItemTemplate}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>