<UserControl x:Class="FlavosDiag.App.Views.Paginas.MemoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FlavosDiag.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="LinhaTemplate" DataType="{x:Type vm:LinhaInfo}">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Rotulo}" Style="{StaticResource RotuloCampo}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding Valor}" Margin="0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ValorCampo}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Ausente}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource FlavosInconclusivo}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoPrimario}"
                        Content="Testar memória" Command="{Binding TestarCommand}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource TextoSuave}"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>

            <Border Style="{StaticResource Cartao}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Selo}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding VereditoTexto}" />
                        </Border>
                        <TextBlock Text="Memória instalada" Style="{StaticResource TituloSecao}" FontSize="15" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Linhas}" ItemTemplate="{StaticResource LinhaTemplate}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progresso}" Margin="0,4,0,12">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Testando}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
        </StackPanel>
    </ScrollViewer>
</UserControl>