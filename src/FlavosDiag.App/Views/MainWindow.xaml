<Window x:Class="FlavosDiag.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FlavosDiag.App.Views"
        Title="Flavos Diag"
        Width="1240" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource FlavosFonte}"
        FontSize="13"
        Foreground="{DynamicResource FlavosTexto}"
        Background="{DynamicResource FlavosSuperficie}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding Resumo.DiagnosticoRapidoCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavegarIndiceCommand}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavegarIndiceCommand}" CommandParameter="1" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavegarIndiceCommand}" CommandParameter="2" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavegarIndiceCommand}" CommandParameter="3" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavegarIndiceCommand}" CommandParameter="4" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding NavegarIndiceCommand}" CommandParameter="5" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding NavegarIndiceCommand}" CommandParameter="6" />
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding NavegarIndiceCommand}" CommandParameter="7" />
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding NavegarIndiceCommand}" CommandParameter="8" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding NavegarIndiceCommand}" CommandParameter="9" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding IniciarNovoDiagnosticoCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding AlternarTemaCommand}" />
        <KeyBinding Key="F1" Command="{Binding AbrirConfiguracoesCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Menu lateral ===== -->
        <Border Grid.Column="0" Background="{DynamicResource FlavosSuperficieAlt}"
                BorderBrush="{DynamicResource FlavosBorda}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource FlavosPetroleo}">
                            <Path Data="M8,21 L13,12 L18,21 L23,7" Stretch="Uniform" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="6" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FLAVOS DIAG" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource FlavosTexto}" />
                            <TextBlock Text="{Binding Versao, StringFormat=versão {0}}" FontSize="10" Foreground="{DynamicResource FlavosTextoSuave}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,14">
                    <Button Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                            Command="{Binding AlternarTemaCommand}" ToolTip="Alternar tema claro/escuro (Ctrl+T)"
                            AutomationProperties.Name="Alternar tema">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icone}" Stroke="{DynamicResource FlavosTexto}" Margin="0,0,8,0">
                                <Path.Data>
                                    <Geometry>M20,14 A8,8 0 1 1 10,4 A6.5,6.5 0 0 0 20,14 Z</Geometry>
                                </Path.Data>
                            </Path>
                            <TextBlock Text="{Binding RotuloTema}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                            Command="{Binding AbrirConfiguracoesCommand}" ToolTip="Configurações (F1)"
                            AutomationProperties.Name="Configurações"
                            Background="{Binding ItemConfiguracoes.Selecionado, Converter={StaticResource FundoDestaqueMenu}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icone}" Stroke="{DynamicResource FlavosTexto}" Margin="0,0,8,0">
                                <Path.Data>
                                    <Geometry>M12,8 A4,4 0 1 0 12.01 8 Z M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M5,5 L7,7 M17,17 L19,19 M19,5 L17,7 M7,17 L5,19</Geometry>
                                </Path.Data>
                            </Path>
                            <TextBlock Text="Configurações" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding StatusBarra}" FontSize="10.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource FlavosTextoSuave}" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ItensNav}" Margin="10,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type views:ItemNav}">
                                <Button x:Name="NavBotao" Command="{Binding Comando}" HorizontalContentAlignment="Left"
                                        Padding="12,9" Margin="0,1" BorderThickness="0" Cursor="Hand" MinHeight="38"
                                        AutomationProperties.Name="{Binding Rotulo}" ToolTip="{Binding Rotulo}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                                                BorderThickness="2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FlavosBorda}" />
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FlavosFoco}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Selecionado}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource FlavosInconclusivoFundo}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icone}" Data="{Binding GeometriaIcone}" Stroke="{DynamicResource FlavosTextoSuave}" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Rotulo}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource FlavosTexto}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Conteúdo ===== -->
        <DockPanel Grid.Column="1" LastChildFill="True">
            <Border DockPanel.Dock="Top" Background="{DynamicResource FlavosFalhaFundo}" Padding="16,8"
                    Visibility="{Binding Demonstracao, Converter={StaticResource BoolVisivel}}">
                <TextBlock Text="MODO DEMONSTRAÇÃO — todos os dados exibidos e exportados são FICTÍCIOS. Reinicie sem --modo-demo para diagnosticar o computador."
                           Foreground="{DynamicResource FlavosFalha}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>

            <Border DockPanel.Dock="Top" Padding="28,18,28,8" Background="{DynamicResource FlavosSuperficie}">
                <TextBlock Text="{Binding TituloPagina}" Style="{StaticResource TituloPagina}" />
            </Border>

            <views:ConteudoPagina Margin="28,0,28,20" />
        </DockPanel>
    </Grid>
</Window>
