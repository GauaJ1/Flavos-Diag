<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>FlavosDiag.App</RootNamespace>
    <AssemblyName>FlavosDiag.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\flavos.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlavosDiag.Core\FlavosDiag.Core.csproj" />
    <ProjectReference Include="..\FlavosDiag.Providers\FlavosDiag.Providers.csproj" />
    <ProjectReference Include="..\FlavosDiag.Reports\FlavosDiag.Reports.csproj" />
    <ProjectReference Include="..\FlavosDiag.Workloads\FlavosDiag.Workloads.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <None Update="Assets\flavos.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
