<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Sobreposição do modo escuro: SOMENTE CORES, com as mesmas chaves de Tema.xaml.
      Este dicionário é mesclado por App.AplicarTema; como fica por último, os valores daqui
      vencem os do tema claro. Estilos não moram aqui: duplicar um Style neste arquivo faria o
      tema escuro ter uma cópia congelada das cores, e a troca de tema em tempo de execução
      deixaria de atualizar aquela parte da interface.

      Para acrescentar uma cor nova, crie a chave nos DOIS arquivos (Tema.xaml e aqui) e use-a
      sempre por DynamicResource em Tema.xaml e nas Views.
    -->

    <!-- Destaque: verde-petróleo mais claro no escuro, para manter contraste AA. -->
    <SolidColorBrush x:Key="FlavosPetroleo" Color="#14B8A6" />
    <SolidColorBrush x:Key="FlavosPetroleoEscuro" Color="#0F766E" />
    <SolidColorBrush x:Key="FlavosPetroleoClaro" Color="#5EEAD4" />

    <!-- Semântica: verde OK, âmbar Atenção, vermelho Falha, cinza Inconclusivo. -->
    <SolidColorBrush x:Key="FlavosOk" Color="#4ADE80" />
    <SolidColorBrush x:Key="FlavosAtencao" Color="#FBBF24" />
    <SolidColorBrush x:Key="FlavosFalha" Color="#F87171" />
    <SolidColorBrush x:Key="FlavosInconclusivo" Color="#94A3B8" />

    <SolidColorBrush x:Key="FlavosOkFundo" Color="#14321F" />
    <SolidColorBrush x:Key="FlavosAtencaoFundo" Color="#3A2A0B" />
    <SolidColorBrush x:Key="FlavosFalhaFundo" Color="#3B1515" />
    <SolidColorBrush x:Key="FlavosInconclusivoFundo" Color="#1E293B" />

    <!-- Tinta e superfícies. -->
    <SolidColorBrush x:Key="FlavosTexto" Color="#F1F5F9" />
    <SolidColorBrush x:Key="FlavosTextoSuave" Color="#94A3B8" />
    <SolidColorBrush x:Key="FlavosSuperficie" Color="#0F172A" />
    <SolidColorBrush x:Key="FlavosSuperficieAlt" Color="#111C33" />
    <SolidColorBrush x:Key="FlavosBorda" Color="#1E293B" />
    <SolidColorBrush x:Key="FlavosFoco" Color="#2DD4BF" />

    <!-- Tinta sobre o destaque (texto de botão primário). No claro é branco puro; no escuro,
         o verde-petróleo fica claro e o texto precisa de tinta escura para manter contraste. -->
    <SolidColorBrush x:Key="FlavosTextoNoDestaque" Color="#06201C" />

</ResourceDictionary>
