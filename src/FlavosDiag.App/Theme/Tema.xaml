<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- Identidade Flavos: verde-petróleo como destaque. Cores semânticas com contraste AA. -->
    <FontFamily x:Key="FlavosFonte">pack://application:,,,/Assets/Fonts/#Geist</FontFamily>

    <SolidColorBrush x:Key="FlavosPetroleo" Color="#0F766E" />
    <SolidColorBrush x:Key="FlavosPetroleoEscuro" Color="#0B5C56" />
    <SolidColorBrush x:Key="FlavosPetroleoClaro" Color="#14B8A6" />

    <SolidColorBrush x:Key="FlavosOk" Color="#15803D" />
    <SolidColorBrush x:Key="FlavosAtencao" Color="#B45309" />
    <SolidColorBrush x:Key="FlavosFalha" Color="#B91C1C" />
    <SolidColorBrush x:Key="FlavosInconclusivo" Color="#475569" />

    <SolidColorBrush x:Key="FlavosOkFundo" Color="#DCFCE7" />
    <SolidColorBrush x:Key="FlavosAtencaoFundo" Color="#FEF3C7" />
    <SolidColorBrush x:Key="FlavosFalhaFundo" Color="#FEE2E2" />
    <SolidColorBrush x:Key="FlavosInconclusivoFundo" Color="#E2E8F0" />

    <SolidColorBrush x:Key="FlavosTexto" Color="#0F172A" />
    <SolidColorBrush x:Key="FlavosTextoSuave" Color="#475569" />
    <SolidColorBrush x:Key="FlavosSuperficie" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FlavosSuperficieAlt" Color="#F8FAFC" />
    <SolidColorBrush x:Key="FlavosBorda" Color="#E2E8F0" />
    <SolidColorBrush x:Key="FlavosFoco" Color="#0F766E" />

    <!-- Tinta sobre o destaque (texto de botão primário, selo). No claro, branco puro;
         no escuro o destaque fica claro e a tinta precisa escurecer (ver TemaEscuro.xaml). -->
    <SolidColorBrush x:Key="FlavosTextoNoDestaque" Color="#FFFFFF" />

    <!-- ============ Botão primário ============ -->
    <Style x:Key="BotaoPrimario" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource FlavosTextoNoDestaque}" />
        <Setter Property="Background" Value="{DynamicResource FlavosPetroleo}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FlavosPetroleo}" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FlavosPetroleoEscuro}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FlavosPetroleoEscuro}" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FlavosBorda}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Botão secundário ============ -->
    <Style x:Key="BotaoSecundario" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource FlavosTexto}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource FlavosBorda}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FlavosSuperficieAlt}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FlavosPetroleo}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FlavosFoco}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Botão de parada (sempre visível durante testes) ============ -->
    <Style x:Key="BotaoParada" TargetType="Button" BasedOn="{StaticResource BotaoPrimario}">
        <Setter Property="Background" Value="{DynamicResource FlavosFalha}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FlavosFalha}" />
    </Style>

    <!-- ============ Cartão de conteúdo (com hierarquia própria: borda + título) ============ -->
    <Style x:Key="Cartao" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FlavosSuperficie}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FlavosBorda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="TituloSecao" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FlavosTexto}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="TituloPagina" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FlavosTexto}" />
    </Style>

    <Style x:Key="RotuloCampo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource FlavosTextoSuave}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ValorCampo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource FlavosTexto}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,1,0,6" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="TextoSuave" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource FlavosTextoSuave}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ============ Semáforo (selo de veredito) ============ -->
    <Style x:Key="Selo" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource FlavosInconclusivoFundo}" />
    </Style>

    <!-- ============ TextBox de formulário ============ -->
    <Style x:Key="CaixaTexto" TargetType="TextBox">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource FlavosBorda}" />
        <Setter Property="Background" Value="{DynamicResource FlavosSuperficie}" />
        <Setter Property="Foreground" Value="{DynamicResource FlavosTexto}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FlavosFoco}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
