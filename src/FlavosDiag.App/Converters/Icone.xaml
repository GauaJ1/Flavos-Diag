<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Ícones de traço único desenhados pelo projeto (24×24, traço 1.6, sem preenchimento).
      Uso: <Path Style="{StaticResource Icone}" Data="{StaticResource IconeCpu}" />
    -->

    <Style x:Key="Icone" TargetType="Path">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Stroke" Value="Black" />
    </Style>

    <Style x:Key="IconeGrande" TargetType="Path" BasedOn="{StaticResource Icone}">
